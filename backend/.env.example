# ==========================================
# PADHLO BACKEND CONFIGURATION (.env.example)
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to GitHub or share secrets!

# Server & Network
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/studyhub?retryWrites=true&w=majority

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_key
OTP_SECRET=replace_with_a_long_random_otp_secret_key

# Initial Administrator Seed Credentials
ADMIN_INITIAL_EMAIL=admin@padhlo.edu
ADMIN_INITIAL_PASSWORD=replace_with_secure_admin_password
ADMIN_INITIAL_NAME=Padhlo Administrator

# AI Summarization & Flashcards (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Appwrite Cloud Storage (Optional primary storage provider)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_BUCKET_ID=your_appwrite_bucket_id

# Email Delivery (Brevo HTTPS Transactional Email API - Recommended for Render)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Padhlo Portal

# Alternative Email Deliveries (Legacy / Fallback)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Padhlo Portal <onboarding@resend.dev>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Padhlo Portal" <your_email@gmail.com>

# Twilio SMS (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ==========================================
# REMOTE APP UPDATE MANIFEST (APK Releases)
# Used by GET /api/app/version to notify Android users of updates
# ==========================================
APP_LATEST_VERSION=1.0.0
APP_MIN_SUPPORTED_VERSION=1.0.0
APP_APK_URL=https://expo.dev/artifacts/eas/nip4aU5qrLySshKJgOoFql-dj5Wio6IQabWow8hZOGM.apk
APP_RELEASE_NOTES=Performance improvements, new study notes, and bug fixes.
APP_UPDATE_REQUIRED=false
APP_UPDATE_PUBLISHED_AT=2026-10-19T00:00:00.000Z
